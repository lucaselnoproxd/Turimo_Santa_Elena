# Base de datos local (dev)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=playas_santa_elena

# Base de datos en producción (si se define, se usa esta sobre las DB_*)
# DATABASE_URL=postgres://usuario:password@host:puerto/nombre

# Seguridad
JWT_SECRET=cambia-este-secreto-en-produccion

# Sincronización de esquema (usa 'false' en producción y configura migraciones)
DB_SYNC=true

# Puerto del servidor
PORT=3000

# Orígenes permitidos por CORS (separados por comas)
# CORS_ORIGINS=http://localhost:5173,https://turismo-santa-elena.vercel.app

# ============================================================
# PANEL DE ADMINISTRACIÓN (FASE 2)
# ============================================================
# Credenciales del panel /admin. OBLIGATORIAS también en producción
# (Vercel). NO dejes valores reales en el código ni en este archivo.
# ADMIN_USER=
# ADMIN_PASS=

# Subida de imágenes (almacenamiento externo, Cloudinary):
# Crea una cuenta gratuita en https://cloudinary.com y pon las tres
# variables de su Dashboard. Sin ellas el módulo de imágenes responde 503.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=